{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashgpt",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-09",
  "preview_urls": true,
  "build": {
    "command": "node --check demo/chatgpt-history-source-runner.js && node --check demo/chatgpt-profile-metrics-import-store.js && node --check demo/chatgpt-profile-metrics-import-bridge.js && node --check demo/profile-metrics.js && node --check demo/catalog-bootstrap.js && node scripts/verify-chatgpt-history-import-f25.mjs && node scripts/verify-chatgpt-history-import-f26.mjs"
  },
  "vars": {
    "GITHUB_APP_ID": "4544269",
    "GITHUB_APP_SLUG": "dashgpt-storage"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./demo",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/openai-apps-challenge",
      "/demo/*"
    ]
  }
}