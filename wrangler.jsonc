{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashgpt",
  "main": "./src/seo-worker.js",
  "compatibility_date": "2026-08-09",
  "preview_urls": true,
  "vars": {
    "GITHUB_APP_ID": "4544269",
    "GITHUB_APP_SLUG": "dashgpt-storage"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./demo",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/robots.txt",
      "/sitemap.xml",
      "/api/*",
      "/mcp",
      "/.well-known/openai-apps-challenge",
      "/demo",
      "/demo/*"
    ]
  }
}
