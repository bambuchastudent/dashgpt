{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashgpt",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-09",
  "preview_urls": true,
  "assets": {
    "directory": "./demo",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/openai-apps-challenge",
      "/demo/*"
    ]
  }
}