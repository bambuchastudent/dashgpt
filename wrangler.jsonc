{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashgpt",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-09",
  "preview_urls": true,
  "build": {
    "command": "node --check demo/gallery-overview-sorting.js && node scripts/verify-gallery-overview-sorting.mjs && npm run check"
  },
  "vars": {
    "GITHUB_APP_ID": "4544269",
    "GITHUB_APP_SLUG": "dashgpt-storage"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./demo",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/openai-apps-challenge",
      "/demo/*"
    ]
  }
}